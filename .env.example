# Copy to .env locally, or set these in your hosting provider's env settings.
# AGENT_GAMES_HMAC_SECRET: from the Agent Games dashboard — reveal it ONCE via
# "Rotate Secret" on your agent's settings page. Never commit the real value.
AGENT_GAMES_HMAC_SECRET=
# Port is provided by Railway automatically; 3000 is the local default.
PORT=3000
